// Mirrors docs/erd.dbml. Change both in the same PR.
// CHECK constraints are not generated by Prisma: they are added by hand in
// the migration SQL (see prisma/migrations/*_init/migration.sql).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ListingCondition {
  LIKE_NEW
  GENTLY_USED
  HEAVILY_USED

  @@map("listing_condition")
}

enum ListingStatus {
  ACTIVE
  PENDING
  COMPLETED

  @@map("listing_status")
}

enum City {
  COCHABAMBA_BO
  AREQUIPA_PE
  SAN_SALVADOR_SV
  UTAH_US

  @@map("city")
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@map("weekday")
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique @db.VarChar(255) // stored lowercased
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(120)
  phoneE164    String   @map("phone_e164") @db.VarChar(20)
  city         City
  avatarUrl    String?  @map("avatar_url") @db.VarChar(500)
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  listings        Listing[]
  reservations    Reservation[]
  ratingsReceived SellerRating[]

  @@map("users")
}

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique @db.VarChar(60)
  slug      String   @unique @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  listings Listing[]

  @@map("categories")
}

model Listing {
  id          String           @id @default(uuid(7)) @db.Uuid
  sellerId    String           @map("seller_id") @db.Uuid
  categoryId  String           @map("category_id") @db.Uuid
  title       String           @db.VarChar(120)
  description String
  condition   ListingCondition
  priceCents  Int              @map("price_cents") // CHECK (price_cents >= 100)
  status      ListingStatus    @default(ACTIVE)
  publishedAt DateTime         @default(now()) @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  seller        User           @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  photos        ListingPhoto[]
  pickupOptions PickupOption[]
  reservation   Reservation?

  @@index([status, publishedAt]) // feed
  @@index([status, categoryId]) // category filter
  @@index([sellerId, status]) // seller tabs
  @@map("listings")
}

model ListingPhoto {
  id         String   @id @default(uuid(7)) @db.Uuid
  listingId  String   @map("listing_id") @db.Uuid
  storageKey String   @map("storage_key") @db.VarChar(500)
  position   Int      @db.SmallInt // CHECK (position BETWEEN 0 AND 2), 0 = cover
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, position])
  @@map("listing_photos")
}

// One pair = one public place + one or more weekdays + one hour range.
model PickupOption {
  id            String    @id @default(uuid(7)) @db.Uuid
  listingId     String    @map("listing_id") @db.Uuid
  locationLabel String    @map("location_label") @db.VarChar(120)
  weekdays      Weekday[] // CHECK (cardinality(weekdays) >= 1)
  startTime     DateTime  @map("start_time") @db.Time(6)
  endTime       DateTime  @map("end_time") @db.Time(6) // CHECK (end_time > start_time)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing      Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@unique([id, listingId]) // target of the composite FK from reservations
  @@index([listingId])
  @@map("pickup_options")
}

model Reservation {
  id                 String    @id @default(uuid(7)) @db.Uuid
  listingId          String    @unique @map("listing_id") @db.Uuid // 1 reservation per item
  pickupOptionId     String    @map("pickup_option_id") @db.Uuid
  buyerId            String    @map("buyer_id") @db.Uuid
  reservedAt         DateTime  @default(now()) @map("reserved_at") @db.Timestamptz(6)
  sellerHandedOverAt DateTime? @map("seller_handed_over_at") @db.Timestamptz(6)
  buyerReceivedAt    DateTime? @map("buyer_received_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing            Listing             @relation(fields: [listingId], references: [id], onDelete: Restrict)
  // Composite FK: the pickup option must belong to THIS listing.
  pickupOption       PickupOption        @relation(fields: [pickupOptionId, listingId], references: [id, listingId], onDelete: Restrict)
  buyer              User                @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  receptionChecklist ReceptionChecklist?
  rating             SellerRating?

  @@index([buyerId, buyerReceivedAt]) // buyer tabs
  @@map("reservations")
}

model ReceptionChecklist {
  reservationId            String   @id @map("reservation_id") @db.Uuid
  matchesListing           Boolean  @map("matches_listing")
  worksNoUndisclosedDamage Boolean  @map("works_no_undisclosed_damage")
  allPartsIncluded         Boolean  @map("all_parts_included")
  issueReport              String?  @map("issue_report") @db.VarChar(1000)
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@map("reception_checklists")
}

model SellerRating {
  id            String   @id @default(uuid(7)) @db.Uuid
  reservationId String   @unique @map("reservation_id") @db.Uuid
  sellerId      String   @map("seller_id") @db.Uuid // copied from reservation → listing.seller_id
  stars         Int      @db.SmallInt // CHECK (stars BETWEEN 1 AND 5)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  seller      User        @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([sellerId]) // average + count for the seller card
  @@map("seller_ratings")
}
