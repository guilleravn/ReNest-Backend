# App
NODE_ENV=development
PORT=3000

# Database (used by docker-compose to create the container)
POSTGRES_USER=renest
POSTGRES_PASSWORD=renest
POSTGRES_DB=renest
DB_PORT=5433

# Database (used by the app and Prisma) - must match the values above
DATABASE_URL="postgresql://renest:renest@localhost:5433/renest?schema=public"

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
# Rate limit per IP: max attempts within the window (login and register)
AUTH_LOGIN_LIMIT=5
AUTH_LOGIN_WINDOW=1m
AUTH_REGISTER_LIMIT=10
AUTH_REGISTER_WINDOW=1h

# e2e tests (npm run test:e2e) - wiped on every run, must differ from DATABASE_URL
DATABASE_URL_TEST="postgresql://renest:renest@localhost:5433/renest_test?schema=public"

# Photo storage (S3 API). Locally, docker-compose runs RustFS with these keys
# and creates S3_BUCKET. In production, use the Railway Bucket's values.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=renest-photos
S3_ACCESS_KEY_ID=renest
S3_SECRET_ACCESS_KEY=renest-secret
# RustFS needs path-style URLs; Railway Buckets use virtual-hosted style (false).
S3_FORCE_PATH_STYLE=true
# How long a presigned photo URL stays valid.
S3_PRESIGN_TTL_SECONDS=3600

# e2e tests (npm run test:e2e) - must differ from S3_BUCKET
S3_BUCKET_TEST=renest-photos-test
