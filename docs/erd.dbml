// ReNest — MVP R1
// Postgres · own auth: email + password (argon2/bcrypt hash) → single JWT access token (no refresh tokens)
// Paste into https://dbdiagram.io to render the diagram.
//
// Conventions:
// - IDs are UUID v7 (@default(uuid(7))). Enum values are UPPER_SNAKE (same in Prisma and in the DB).
// - Prisma does not generate CHECK constraints: every "CHECK (...)" below is added by hand in the
//   migration SQL (prisma migrate dev --create-only). Initial ones: prisma/migrations/*_init.
// - onDelete is Restrict unless the ref says otherwise.
// - Money: integer cents of the local currency, no currency column (buyer and seller meet in the same city).
// - Pickup times: local wall-clock time of the meetup city, no timezone. System timestamps are timestamptz.

Enum listing_condition {
  LIKE_NEW      // Como nuevo
  GENTLY_USED   // Poco uso
  HEAVILY_USED  // Muy usado
}

Enum listing_status {
  ACTIVE      // published, reservable → seller tab "Activos"
  PENDING     // reserved, waiting for the seller's handover → seller tab "En proceso"
  COMPLETED   // seller confirmed the handover → seller tab "Completados"
}

Enum city {
  COCHABAMBA_BO     // Cochabamba, BO
  AREQUIPA_PE       // Arequipa, PE
  SAN_SALVADOR_SV   // San Salvador, SV
  UTAH_US           // Utah, US
}

Enum weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

Table users {
  id            uuid [pk]
  email         varchar(255) [not null, unique, note: 'Stored lowercased']
  password_hash varchar(255) [not null, note: 'Never returned by the API or logged']
  full_name     varchar(120) [not null]
  phone_e164    varchar(20)  [not null, note: 'Required at sign-up: WhatsApp is how buyer and seller coordinate. Shown to logged-in users on the listing detail ("Doubts about this product?") and to the other party inside a reservation. Never to anonymous visitors']
  city          city [not null, note: 'PUBLIC. Picked at sign-up from a fixed list. Shown as the listing location']
  avatar_url    varchar(500) [note: 'Nullable → frontend shows initials. Set by seed only in R1']
  is_verified   boolean [not null, default: false, note: 'Set manually (seed/SQL). No endpoint']
  created_at    timestamptz [not null, default: `now()`]
  updated_at    timestamptz [not null, default: `now()`]
}

Table categories {
  id          uuid [pk]
  name        varchar(60) [not null, unique]
  slug        varchar(60) [not null, unique]
  created_at  timestamptz [not null, default: `now()`]
  updated_at  timestamptz [not null, default: `now()`]

  Note: 'Seeded: Muebles, Electrónica, Hogar. No admin endpoint'
}

Table listings {
  id            uuid [pk]
  seller_id     uuid [not null, ref: > users.id]
  category_id   uuid [not null, ref: > categories.id]
  title         varchar(120) [not null]
  description   text [not null]
  condition     listing_condition [not null]
  price_cents   int [not null, note: 'CHECK (price_cents >= 100) → minimum $1. Max 2 000 000 000 validated in the DTO']
  status        listing_status [not null, default: 'ACTIVE']
  published_at  timestamptz [not null, default: `now()`]
  created_at    timestamptz [not null, default: `now()`]
  updated_at    timestamptz [not null, default: `now()`]

  indexes {
    (status, published_at)   // feed
    (status, category_id)    // category filter
    (seller_id, status)      // seller tabs
  }

  Note: '''
  Publish = one transaction: listing + 1–3 photos + 1–3 pickup options. No drafts.
  Editing (details, photos, pickup pairs) only while ACTIVE, locking the row (SELECT … FOR UPDATE) so it can't race a reservation. published_at never changes.
  Search: title ILIKE '%kw%'.
  ACTIVE → PENDING on reserve: UPDATE listings SET status = 'PENDING' WHERE id = ? AND status = 'ACTIVE' (0 rows → 409).
  PENDING → COMPLETED when the seller confirms the handover.
  '''
}

Table listing_photos {
  id          uuid [pk]
  listing_id  uuid [not null, ref: > listings.id, note: 'onDelete: Cascade']
  storage_key varchar(500) [not null]
  position    smallint [not null, note: 'CHECK (position BETWEEN 0 AND 2). 0 = cover']
  created_at  timestamptz [not null, default: `now()`]
  updated_at  timestamptz [not null, default: `now()`]

  indexes {
    (listing_id, position) [unique, note: 'Editing photos replaces the whole set in one transaction: DELETE the listing rows, then INSERT the new order (kept photos are re-inserted with their same storage_key). Avoids position collisions. Replaced photos stay in S3/R2 (no cleanup in R1)']
  }
}

// One pair = one public place + one or more weekdays + one hour range.
// The buyer picks a pair; the exact day is coordinated on WhatsApp.
Table pickup_options {
  id             uuid [pk]
  listing_id     uuid [not null, ref: > listings.id, note: 'onDelete: Cascade']
  location_label varchar(120) [not null, note: 'PUBLIC place, e.g. "Café Toscano, Av. Álvaro Obregón". Also used to build the Google Maps link']
  weekdays       "weekday[]" [not null, note: 'Prisma: Weekday[]. Prisma lists are nullable in the DB, so NOT NULL lives in the CHECK: CHECK (weekdays IS NOT NULL AND cardinality(weekdays) >= 1). No duplicates (DTO)']
  start_time     time [not null, note: 'Prisma: DateTime @db.Time']
  end_time       time [not null, note: 'CHECK (end_time > start_time)']
  created_at     timestamptz [not null, default: `now()`]
  updated_at     timestamptz [not null, default: `now()`]

  indexes {
    listing_id
    (id, listing_id) [unique, note: 'Target of the composite FK from reservations']
  }

  Note: '1–3 per listing. Created at publish; while the listing is ACTIVE the seller can add or remove pairs (never below 1). No in-place edit. A reserved pair is protected by the Restrict FK from reservations'
}

Table reservations {
  id                    uuid [pk]
  listing_id            uuid [not null, unique, ref: > listings.id, note: 'UNIQUE: 1 reservation per item, no cancellation']
  pickup_option_id      uuid [not null]
  buyer_id              uuid [not null, ref: > users.id]
  reserved_at           timestamptz [not null, default: `now()`]
  seller_handed_over_at timestamptz [note: '"Confirmar entrega". Moves the listing to COMPLETED in the same transaction']
  buyer_received_at     timestamptz [note: '"Marcar como recogido" (optional for the buyer). Saved with the reception checklist']
  created_at            timestamptz [not null, default: `now()`]
  updated_at            timestamptz [not null, default: `now()`]

  indexes {
    (buyer_id, buyer_received_at)   // "Agendados" / "Completados" tabs
  }

  Note: '''
  Composite FK (pickup_option_id, listing_id) → pickup_options(id, listing_id): the option must belong to THIS listing.
  No self-reservation: buyer_id <> listings.seller_id (service).
  No status column. Buyer tabs: "Agendados" = buyer_received_at IS NULL, "Completados" = buyer_received_at IS NOT NULL.
  Only the buyer's reception moves the purchase. seller_handed_over_at never blocks the buyer: they can still confirm reception and rate.
  Reserve order: lock the listing (UPDATE … WHERE status = 'ACTIVE') BEFORE checking the pickup option. FK errors mapped: P2002 → 409, P2003 → 422.
  '''
}

Ref: reservations.(pickup_option_id, listing_id) > pickup_options.(id, listing_id) [delete: restrict]

// "Lista de recepción", saved together with buyer_received_at
Table reception_checklists {
  reservation_id              uuid [pk, ref: - reservations.id]
  matches_listing             boolean [not null, note: 'Coincide con las fotos y la descripción']
  works_no_undisclosed_damage boolean [not null, note: 'Funciona / sin daños no informados']
  all_parts_included          boolean [not null, note: 'Incluye todas las partes y accesorios']
  issue_report                varchar(1000) [note: '"¿Algo que quieras reportar?" Optional']
  created_at                  timestamptz [not null, default: `now()`]
  updated_at                  timestamptz [not null, default: `now()`]

  Note: '"Tengo el artículo conmigo ahora" must be true to submit → validated in the DTO, not stored (it would always be true)'
}

Table seller_ratings {
  id             uuid [pk]
  reservation_id uuid [not null, unique, ref: - reservations.id]
  seller_id      uuid [not null, ref: > users.id, note: 'Copied from reservation → listing.seller_id, never from client input']
  stars          smallint [not null, note: 'CHECK (stars BETWEEN 1 AND 5)']
  created_at     timestamptz [not null, default: `now()`]
  updated_at     timestamptz [not null, default: `now()`]

  indexes {
    seller_id   // average + count for the seller card
  }

  Note: 'Only the buyer of that reservation, only after buyer_received_at is set, only once'
}
